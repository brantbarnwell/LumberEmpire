# Copy this file to .env and fill in the value. Never commit .env.
# RevenueCat > Project > API keys > Apple App Store public key (starts with appl_)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# AdMob (rewarded videos). Leave empty to use Google's test ads.
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
